# Copy to .env.local and fill in. Do not commit real secrets.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_TREASURY_PUBKEY=
NEXT_PUBLIC_DEVNET_USDC_MINT=

# Server-only signer that holds pad vaults and signs milestone releases (base58 secret key)
SIGNER_SECRET_B58=

# Groq API key for the plain-language ledger summaries
GROQ_API_KEY=

# Neon Postgres connection string (pooled).
DATABASE_URL=

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=
